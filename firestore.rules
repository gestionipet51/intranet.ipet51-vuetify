rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }

    match /editors/{userId} {
      allow read, write: if false;
    }

    match /matriculas/{matriculaId} {
      allow read, write: if isEditor();
    }

    match /cursos/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /dependencias/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /miembrosdependencia/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /catalogos/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /itemscatalogo/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /roles/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /departamentos/{documentId} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
